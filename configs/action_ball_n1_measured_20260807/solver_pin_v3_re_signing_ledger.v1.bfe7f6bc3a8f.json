  "materialize_measured_action_ball_n1_bundle.py prepare --profile-pins configs/action_ball_n1_measured_20260806/fresh_core_seed0_20260806_r2/action_ball_profile_pins.live.v2.5564d5b3c09d.json --output-dir configs/action_ball_n1_measured_20260807/v3pin_core_seed0_20260807_r1",
  "materialize_action_ball_n1_fixed_tape_variants.py --prepared-core-bundle configs/action_ball_n1_measured_20260807/v3pin_core_seed0_20260807_r1/take_061_unit04_bh.measured_prepared_core.v1.6d2dd4357be2.json --seed 0 --output-dir configs/action_ball_n1_measured_20260807/v3pin_tape_seed0_20260807_r1",
  "materialize_action_ball_c211_lineage.py --action-manifest-path configs/action_ball_n1_measured_20260807/v3pin_core_seed0_20260807_r1/take_061_unit04_bh.full.manifest.v3.bb65ca3f3a8e.json --initial-center-task-receipt-path configs/action_ball_n1_measured_20260807/v3pin_tape_seed0_20260807_r1/outcome_dense_only.target.task_receipt.v5.f9b81255722d.json --output configs/action_ball_n1_measured_20260807/c211_lineage_20260807/c211_direct_ball_split_ready_lineage.v4.json",
  "materialize_action_ball_a211_lineage.py --action-manifest-path configs/action_ball_n1_measured_20260807/v3pin_core_seed0_20260807_r1/take_061_unit04_bh.full.manifest.v3.bb65ca3f3a8e.json --initial-center-task-receipt-path configs/action_ball_n1_measured_20260807/v3pin_tape_seed0_20260807_r1/current_lm.target.task_receipt.v5.f9b81255722d.json --output configs/action_ball_n1_measured_20260807/a211_lineage_20260807/a211_split_ready_lineage.v5.json"
