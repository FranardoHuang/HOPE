{
  "schema_version": 1,
  "catalog_id": "motion-role-catalog-20260720",
  "purpose": "Single semantic source of truth for the motion library roles: which assets are stationary strikes, which are the shared lateral footwork module, and which pair is the formal runtime pair.",
  "human_note": "人话：这份表定死每条动作素材的语义角色。非 motion/ 的击球都是原地击球（不冻结腿、允许重心变化，只是不有意平移/迈步）；motion/ 的四条 dang 是跨动作复用的共享横移脚步模块，只能被有效击球意图触发；v4rg 一对 npz 是现役 formal 训练动作。语义以本表为准，旧 intake 文件字节不改。",
  "semantic_authority": {
    "statement": "This catalog is the only semantic truth source for motion roles. The intake manifests stay byte-frozen as content-addressed provenance records; their role/action_slot fields are historical.",
    "supersedes": [
      {
        "manifest": "configs/motion_video_intake_20260713.json",
        "fields": [
          "role",
          "action_slot"
        ],
        "historical_values": [
          "lateral_locomotion_teacher",
          "lateral_step_teacher"
        ],
        "note": "The 2026-07-13 intake labeled the four motion/ dang clips as a standalone displacement-conditioned lateral locomotion teacher slot. The frozen 2026-07-20 semantics rename them the shared lateral footwork module: reused across all strike actions, activated only by valid strike intent, with no standalone locomotion action and no standalone stop teacher. The intake file bytes must not change."
      }
    ]
  },
  "formal_runtime_pair": {
    "asset_ids": [
      "hope_forehand_v4rg_cal",
      "hope_backhand_v4rg_cal"
    ],
    "statement": "The v4rg forehand/backhand runtime NPZ pair is the currently bound formal training pair. Its contract predates the vendor-MuJoCo dynamic gate, so it carries the only grandfathered_formal_runtime_pair=true exception to the 'no dynamic pass, no training authorization' rule."
  },
  "frozen_semantics": {
    "stationary_strike": "Every strike asset outside motion/ is a stationary strike: 'stationary' only means no intentional base translation or stepping; legs are not frozen and weight shift / lower-body variation is allowed.",
    "shared_lateral_footwork_module": "motion/{left,right}_dang{1,2}.mp4 form one shared lateral footwork module reused across all strike actions; there is no standalone locomotion action and no standalone stop teacher.",
    "strike_intent_trigger": "Lateral movement may only be triggered by valid strike intent. Within the stationary reach/deadband the strike's own lower-body reference is used; beyond it the shared footwork module is composed with the strike via prepare->strike->recover event alignment. No strike intent, no movement.",
    "derived_composition_regate": "Every derived <strike, footwork, signed distance, phase alignment, retiming> motion must re-pass the full gate chain before any training use.",
    "safety_facts_not_overridden": "This semantic revision does not override safety facts: the M0 stance gate is still rejected at 0/4, and Franco backhand loop B has static/mj_forward evidence only (mj_step_calls=0), so it must not be described as 'does not fall' or training_authorized."
  },
