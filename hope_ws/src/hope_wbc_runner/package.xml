<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hope_wbc_runner</name>
  <version>0.0.0</version>
  <description>HOPE WBC runner: staged, safety-gated ROS 2 controller that runs the model_15200 ONNX from /racket/command and (only when explicitly enabled) emits low-level joint commands. Bring-up companion to planner_imitate.</description>
  <maintainer email="maintainer@example.com">HOPE Maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>hope_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- onnxruntime is a pip dependency (not rosdep); install in the runtime python. -->
  <!-- joint_msgs is only required in hardware mode (lazy-imported); build it if you publish joint cmds. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
